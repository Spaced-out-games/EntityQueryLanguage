// Token definitions
DECIMAL_INT: /[0-9]+/
HEXADECIMAL_INT: /0[xX][0-9a-fA-F]+/
DECIMAL_FLOAT: /[0-9]+\.[0-9]+/
STRING: /"(?:\\.|[^"\\])*"/


ASSIGN_OP: "+=" | "-=" | "*=" | "/=" | "%=" | "="
COMPOUND_OP: "+=" | "-=" | "*=" | "/=" | "%="
assign_op: ASSIGN_OP
// ignore whitespace
%import common.WS
%ignore WS
// ignore single-line comments
%ignore /\/\/[^\n]*/

// identifier matching, ignores keywords
   NAME: /(?!(?:static|inline|const|mut|virtual|struct|if|else|for|while|return|continue|break)\b)[a-zA-Z_][a-zA-Z0-9_]*/

identifier: NAME

?integer_literal: DECIMAL_INT | HEXADECIMAL_INT
?float_literal: DECIMAL_FLOAT

// literals
number_literal: integer_literal | float_literal
string_literal: STRING

literal: number_literal | string_literal

// typenames
typename: NAME
static: "static"
inline: "inline"
const: "const"
mut: "mut"
type_qualifier: const | mut | static | inline
reference: "&"

array_access: "[" expression "]"
array_size: "[" integer_literal "]"


type_suffix: array_size | reference

// arguments
argument_list: expression ("," expression)*


// fully qualified type
qualified_type: type_qualifier* typename [type_suffix]



// declarations
declaration: qualified_type identifier [initializer] ";"

// initializers
initializer: "=" expression

// decorators
decorator_value: NAME
decorator_type: NAME

decorator: "@" decorator_type [decorator_arguments | decorator_value]
decorators: decorator+
decorator_arguments: "(" [argument_list] ")"



// expressions ?
?expression: assignment

// Assignment:
?assignment: logic_or
           | unary assign_op assignment        -> assign
           | unary COMPOUND_OP assignment -> compound_assign

?logic_or: logic_and
            | logic_or "||" logic_and -> logical_or

?logic_and: bitwise_or
            | logic_and "&&" bitwise_or -> logical_and

// Bitwise operators
?bitwise_or: bitwise_xor
            | bitwise_or "|" bitwise_xor -> bitwise_or

?bitwise_xor: bitwise_and
            | bitwise_xor "^" bitwise_and -> bitwise_xor

?bitwise_and: equality
            | bitwise_and "&" equality -> bitwise_and

// Comparisons
?equality: comparison
            | equality "==" comparison -> equal
            | equality "!=" comparison -> not_equal

?comparison: shift
            | comparison "<" shift -> less
            | comparison "<=" shift -> less_equal
            | comparison ">" shift -> greater
            | comparison ">=" shift -> greater_equal

// Arithmetic
?shift: sum
        | shift "<<" sum -> left_shift
        | shift ">>" sum -> right_shift

?sum: product
    | sum "+" product -> add
    | sum "-" product -> subtract

?product: unary
        | product "*" unary -> multiply
        | product "/" unary -> divide
        | product "%" unary -> modulo

?unary: "+" unary -> positive
        | "-" unary -> negate
        | "!" unary -> logical_not
        | "~" unary -> bitwise_not
        | postfix

?postfix: atom
        | postfix "." NAME -> member
        | postfix array_access -> index
        | postfix "(" [argument_list] ")" -> call

expression_statement: expression ";"

statement: expression_statement | declaration | if_statement | for_statement | while_statement | return_statement | continue_statement | break_statement



// Primary expressions
?atom: literal
     | NAME -> var_ref
     | "(" expression ")"



?variable_access: NAME
?member_access: NAME "." NAME



// finally, high-level constructs:

// functions

?return_type: qualified_type
?function_name: NAME
?argument_name: NAME
argument_declaration: qualified_type argument_name


parameter_list: argument_declaration ("," argument_declaration)*


block: "{" statement* "}"

function_definition: [decorators] return_type function_name "(" [parameter_list] ")" block


virtual_tag: "virtual"

// control flow

else_clause: "else" (if_statement | block)

if_statement: "if" "(" expression ")" block [else_clause]

for_statement: "for" "(" [for_init] ";" [for_cond] ";" [for_step] ")" block

break_statement: "break" ";"
continue_statement: "continue" ";"

for_init: expression
for_cond: expression
for_step: expression

while_statement: "while" "(" expression ")" block
return_statement: "return" expression? ";"


// structs
struct_name: NAME
struct_member: qualified_type identifier initializer? ";"
struct_definition: [decorators] [virtual_tag] "struct" struct_name "{" struct_member* "}" ";"



// entry point

start: entry*

entry: declaration | function_definition | struct_definition


# needs break, continue, switch-case is optional